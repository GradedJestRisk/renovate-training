{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":prHourlyLimitNone"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "commitMessagePrefix": "[BUMP]",
  "rebaseWhen": "auto",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["oxfmt"],
      "automerge": true
    }
  ]
}
