{
  "name": "renovate-training",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "npm run lint:dependencies && npm run lint:renovate-configuration",
    "lint:dependencies": "knip --no-progress",
    "lint:renovate-configuration": "renovate-config-validator --strict renovate.json",
    "test": "npm run format && npm run lint && npm run test:unit",
    "test:unit": "mocha",
    "dry-run": "renovate --platform=local --dry-run=extract"
  },
  "devDependencies": {
    "chai": "^6.0.0",
    "knip": "^6.34.0",
    "mocha": "^12.0.0",
    "oxfmt": "^0.75.0",
    "renovate": "^44.220.0"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
